compile_commands.json
Makefile
*.ninja
.ninja_deps
.ninja_log

# clangd / Language Server cache
.cache/

# Compiled binaries and object files
*.o
*.obj
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.a
*.lib

# VS Code & OS files
.vscode/
.DS_Store
Thumbs.db
